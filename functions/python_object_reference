#Examples of pass by value and pass by reference in Python
def upload_resume(file_name):
    return f"{file_name} uploaded successfully."

result = upload_resume("resume.pdf")
print(result)
# resume.pdf uploaded successfully.


def add_item(my_list):
    my_list.append(100)

numbers = [10, 20, 30]
add_item(numbers)

print(numbers)
# [10, 20, 30, 100]



def change_name(name):
    name = name + " Kumar"
    print("Inside function:", name)

student = "Rahul"

change_name(student)

print("Outside function:", student)
# Inside function: Rahul Kumar
# Outside function: Rahul



def modify_data(text, my_tuple):
    # Creating new objects
    text = text + " World"
    my_tuple = my_tuple + (40,)

    print("Inside String:", text)
    print("Inside Tuple:", my_tuple)

name = "Hello"
numbers = (10, 20, 30)

modify_data(name, numbers)
print("Outside String:", name) # Hello
print("Outside Tuple:", numbers) # (10, 20, 30)

def modify_data(my_list, my_dict):
    # Modifying existing objects
    my_list.append(40)
    my_dict["city"] = "Hyderabad"

numbers = [10, 20, 30]
person = {
    "name": "Rahul",
    "age": 25
}

modify_data(numbers, person)
print("List:", numbers) #[10, 20, 30, 40]
print("Dictionary:", person) # {'name': 'Rahul', 'age': 25, 'city': 'Hyderabad'}

